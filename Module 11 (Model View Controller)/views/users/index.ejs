<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <main>
      <h1>Users</h1>
      <p><a href="/users/new">Create user</a></p>

      <% if (users.length === 0) { %>
        <p>No users yet.</p>
      <% } else { %>
        <% users.forEach((user) => { %>
          <div>
            <h2><%= user.firstName %></h2>
            <p>Email: <%= user.email %></p>
          </div>
        <% }) %>
      <% } %>
    </main>
  </body>
</html>